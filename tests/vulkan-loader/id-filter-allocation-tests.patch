+// Fail each of the device/vendor/driver filter allocations in both count-only and
+// output-array calls. Earlier filters must be freed and a later call must still work.
+class IdFilterAllocationFailure : public testing::TestWithParam<std::tuple<bool, uint32_t, bool>> {};
+
+TEST_P(IdFilterAllocationFailure, ReturnsOutOfHostMemoryAndCleansUp) {
+    const auto [enumerate_groups, filter_index, return_handles] = GetParam();
+    FrameworkEnvironment env{};
+    auto& driver = env.add_icd(TEST_ICD_PATH_VERSION_2, {}, ManifestICD{}.set_api_version(VK_API_VERSION_1_1))
+                       .set_min_icd_interface_version(5)
+                       .set_icd_api_version(VK_API_VERSION_1_1)
+                       .add_instance_extension({VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME});
+    auto& device = driver.add_and_get_physical_device("physical_device_0");
+    device.properties.apiVersion = VK_API_VERSION_1_1;
+    device.properties.deviceID = 0x1001;
+    device.properties.vendorID = 0x2001;
+    device.driver_properties.driverID = VK_DRIVER_ID_NVIDIA_PROPRIETARY;
+    driver.physical_device_groups.push_back(PhysicalDeviceGroup({0}));
+
+    MemoryTracker tracker;
+    {
+        InstWrapper inst{env.vulkan_functions, tracker.get()};
+        inst.create_info.set_api_version(VK_API_VERSION_1_1);
+        ASSERT_NO_FATAL_FAILURE(inst.CheckCreate());
+
+        uint32_t count = 1;
+        VkPhysicalDevice handle = VK_NULL_HANDLE;
+        VkPhysicalDeviceGroupProperties group{};
+        group.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_GROUP_PROPERTIES;
+        auto enumerate = [&]() {
+            count = 1;
+            if (enumerate_groups) {
+                return inst->vkEnumeratePhysicalDeviceGroups(inst, &count, return_handles ? &group : nullptr);
+            }
+            return inst->vkEnumeratePhysicalDevices(inst, &count, return_handles ? &handle : nullptr);
+        };
+
+        // Warm up the ICD/loader caches before arming the allocation failure.
+        ASSERT_EQ(VK_SUCCESS, enumerate());
+        ASSERT_EQ(1U, count);
+        env.env_var_vk_loader_device_id_filter.set_new_value("0x1001");
+        env.env_var_vk_loader_vendor_id_filter.set_new_value("0x2001");
+        env.env_var_vk_loader_driver_id_filter.set_new_value(std::to_string(VK_DRIVER_ID_NVIDIA_PROPRIETARY));
+        const size_t live_allocations = tracker.live_allocation_count();
+#if defined(_WIN32)
+        // Windows also allocates a UTF-8 environment string before each filter.
+        tracker.arm_allocation_failure_after(2 * filter_index + 1);
+#else
+        tracker.arm_allocation_failure_after(filter_index);
+#endif
+        EXPECT_EQ(VK_ERROR_OUT_OF_HOST_MEMORY, enumerate());
+        EXPECT_EQ(live_allocations, tracker.live_allocation_count());
+        tracker.clear_allocation_failure();
+        ASSERT_EQ(VK_SUCCESS, enumerate());
+        ASSERT_EQ(1U, count);
+    }
+    EXPECT_TRUE(tracker.empty());
+}
+
+INSTANTIATE_TEST_SUITE_P(Allocation, IdFilterAllocationFailure,
+                        testing::Combine(testing::Values(false, true), testing::Values(0U, 1U, 2U),
+                                         testing::Values(false, true)));
+
